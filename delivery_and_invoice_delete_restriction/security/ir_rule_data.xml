<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Delivery Orders (stock.picking): block delete unless
             the company restriction is off, or the user is on the
             company's allowed-delete list. -->
        <record id="rule_do_and_po_restrict_delete_stock_picking" model="ir.rule">
            <field name="name">Restrict Delivery Order Delete</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="domain_force">
                ['|',
                    ('company_id.restrict_do_invoice_delete', '=', False),
                    ('company_id.delete_allowed_user_ids', 'in', [user.id])]
            </field>
            <field name="perm_read">0</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">1</field>
            <field name="global" eval="True"/>
        </record>

        <!-- Invoices / Credit Notes -->
        <record id="rule_do_and_po_restrict_delete_account_move" model="ir.rule">
            <field name="name">Restrict Invoice Delete</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">
                ['|',
                    ('company_id.restrict_do_invoice_delete', '=', False),
                    ('company_id.delete_allowed_user_ids', 'in', [user.id])]
            </field>
            <field name="perm_read">0</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">1</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
