<odoo>
    <record id="view_change_storage_location_wizard" model="ir.ui.view">
        <field name="name">change.storage.location.wizard.form</field>
        <field name="model">change.storage.location.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Storage Location">
                <group>
                    <field name="storage_location"/>
                </group>
                <footer>
                    <button name="action_save"
                            string="Save"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_change_storage_location_wizard" model="ir.actions.act_window">
        <field name="name">Change Storage Location</field>
        <field name="res_model">change.storage.location.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>